# Config del SDK web de Firebase. Se copia a .env.local (que no se sube al repo) con los
# valores reales de Consola Firebase > Configuración del proyecto > Tus apps > SDK de Firebase.
#
# Estos valores identifican el proyecto, no son secretos: Firebase los protege con las reglas
# de seguridad del proyecto, no ocultándolos, y terminan de todos modos en el bundle del
# navegador. Aun así van en .env.local y no a mano en el código, para poder tener un proyecto
# de prueba y otro real sin tocar una línea.
#
# Vite solo expone al cliente las variables que empiezan con VITE_ (ver vite.config.ts).
#
# Lo usa src/lib/firebase.ts para inicializar Firebase Auth (login por email y contraseña, ver
# README.md > Acceso). Firebase Storage sigue en stand by, sin código propio todavía.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENTID=